---
import Icon from './Icon.astro';
const { heading = 'Help us make the principles workable.' } = Astro.props;
---
<section class="feedback-section" id="feedback"><span class="eyebrow">AN OPEN CONVERSATION</span><h2>{heading}</h2><form data-feedback-form class="feedback-form"><div class="form-pair"><label class="field">Name <span class="optional">Optional</span><input name="name" autocomplete="name" maxlength="100" /></label><label class="field">Email <span class="optional">Optional, for a reply</span><input name="email" type="email" autocomplete="email" maxlength="254" /></label></div><label class="field">Your perspective<select name="role" required><option value="">Choose a role</option><option>Creator / maintainer</option><option>Builder</option><option>Company</option><option>Other</option></select></label><label class="field">Your feedback<textarea name="feedback" rows="5" required maxlength="5000" placeholder="What should we think through?" /></label><div class="feedback-actions"><button class="button feedback-submit" type="submit" disabled>Preview feedback <Icon/></button><p class="form-note">Preview mode. Nothing is sent or stored.</p></div><p class="form-result" role="status" tabindex="-1" hidden></p></form></section>
<script>
document.querySelectorAll<HTMLButtonElement>('[data-feedback-form] button[type="submit"]').forEach(button => button.disabled = false);
document.querySelectorAll<HTMLFormElement>('[data-feedback-form]').forEach(form => form.addEventListener('submit', e => { e.preventDefault(); if (!form.reportValidity()) return; const result = form.querySelector<HTMLElement>('.form-result'); if (result) { result.hidden = false; result.textContent = 'Feedback preview complete. Your message has not been sent; submissions will open when the site launches.'; result.focus(); } }));
</script>

<style>
.feedback-actions{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:24px;border:1px solid #ccc;background:#f3f3f3}
.feedback-submit.button{flex:none;background:#111;border-color:#111;color:#fff;gap:24px}
.feedback-submit.button:is(:hover,:focus-visible):not(:disabled){background:#fff;border-color:#111;color:#111}
.feedback-actions .form-note{max-width:240px;margin:0;color:#555}
@media(max-width:768px){
 .feedback-actions{flex-direction:column;align-items:stretch;gap:16px;padding:16px}
 .feedback-submit.button{width:100%}
 .feedback-actions .form-note{max-width:none}
}
</style>
