---
import Icon from './Icon.astro';
const { heading = 'Help us make the principles workable.' } = Astro.props;
---
<section class="feedback-section" id="feedback"><span class="eyebrow">AN OPEN CONVERSATION</span><h2>{heading}</h2><form data-email-form="feedback" class="feedback-form"><div class="form-pair"><label class="field">Name <span class="optional">Optional</span><input name="name" autocomplete="name" maxlength="100" /></label><label class="field">Email <span class="optional">Optional, for a reply</span><input name="email" type="email" autocomplete="email" maxlength="254" /></label></div><label class="field">Your perspective<select name="role" required><option value="">Choose a role</option><option>Creator / maintainer</option><option>Builder</option><option>Company</option><option>Other</option></select></label><label class="field">Your feedback<textarea name="feedback" rows="5" required maxlength="5000" placeholder="What should we think through?" /></label><label class="email-honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label><div class="feedback-actions"><button class="button feedback-submit" type="submit" disabled><span data-submit-label>Send feedback</span> <Icon/></button><p class="form-note">Contact: <a href="mailto:support@b150.ai">support@b150.ai</a>.</p></div><p class="form-result" role="status" tabindex="-1" hidden></p><noscript><p class="form-note">Please email <a href="mailto:support@b150.ai">support@b150.ai</a> directly.</p></noscript></form></section>
<script>
import { mountEmailForms } from '../lib/email-forms';
mountEmailForms();
</script>

<style>
.feedback-actions{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:24px;border:1px solid #ccc;background:#f3f3f3}
.feedback-submit.button{flex:none;background:#111;border-color:#111;color:#fff;gap:24px}
.feedback-submit.button:is(:hover,:focus-visible):not(:disabled){background:#fff;border-color:#111;color:#111}
.feedback-actions .form-note{max-width:240px;margin:0;color:#555}
@media(max-width:768px){
 .feedback-actions{flex-direction:column;align-items:stretch;gap:16px;padding:16px}
 .feedback-submit.button{width:100%}
 .feedback-actions .form-note{max-width:none}
}
</style>
