---
// Feedback on the proposal happens in public on GitHub: this block points there and shows the latest threads.
// `section` closes a reading page (proposal, manifesto); `panel` fills the join page's right column.
import Icon from './Icon.astro';
import DiscussionFeed from './DiscussionFeed.astro';
import { github } from '../lib/links';
interface Props { heading?: string; eyebrow?: string; intro?: string; variant?: 'section' | 'panel' }
const {
  heading = 'Help us make the principles workable.',
  eyebrow = 'AN OPEN CONVERSATION',
  intro = 'Feedback on the proposal happens in public on GitHub, where anyone can read it, build on it, and hold us to it.',
  variant = 'section',
} = Astro.props;
---
<section id="feedback" class:list={['conversation', `conversation-${variant}`]} aria-labelledby="feedback-heading">
  <span class="eyebrow">{eyebrow}</span>
  <h2 id="feedback-heading">{heading}</h2>
  <p class="conversation-intro">{intro}</p>
  <div class="conversation-actions">
    <a class="button conversation-start" href={github.newDiscussion}>Start a discussion <Icon/></a>
    <a class="text-link" href={github.proposalIssue}>Challenge a specific part <Icon/></a>
  </div>
  <DiscussionFeed />
  <p class="conversation-private">Posting needs a free GitHub account. Prefer to reach us privately? Email <a href="mailto:support@b150.ai">support@b150.ai</a>.</p>
</section>

<style>
.conversation-section{margin-top:64px;border-top:1px solid var(--line);padding-top:48px}
.conversation h2{font-size:40px;margin-top:24px}
.conversation-intro{margin-top:16px;max-width:560px;font-size:18px;line-height:1.6;color:#4a4a4a}
.conversation-actions{display:flex;flex-wrap:wrap;align-items:center;gap:16px 32px;margin-top:32px}
.conversation-start.button{background:#111;border-color:#111;color:#fff}
.conversation-start.button:is(:hover,:focus-visible){background:#245794;border-color:#245794;color:#fff}
.conversation-private{margin-top:32px;font-size:14px;line-height:1.6;color:#6a6a6a}
.conversation-private a{color:#111;text-decoration:underline;text-underline-offset:4px;text-decoration-thickness:1px}
@media(max-width:768px){
 .conversation-section{margin-top:48px;padding-top:40px}
 .conversation h2{font-size:32px}
 .conversation-intro{font-size:16px}
 .conversation-start.button{width:100%}
}
</style>
