---
// The newest public GitHub Discussions about the proposal. The static link works on its own;
// the script swaps in live threads from /api/discussions when they load.
import Icon from './Icon.astro';
import { github } from '../lib/links';
---
<section id="discussion" class="discussion-feed" aria-labelledby="discussion-heading" data-discussions>
  <span class="eyebrow">FROM THE PUBLIC DISCUSSION</span>
  <h2 id="discussion-heading">What people are debating on GitHub.</h2>
  <p class="discussion-note" data-discussion-note>The proposal is debated in public on GitHub. <a href={github.discussions}>Join the discussion</a>.</p>
  <p class="discussion-note" data-discussion-none hidden>No one has started a discussion yet. <a href={github.discussions}>Start the first one on GitHub</a>.</p>
  <ol class="discussion-list" data-discussion-list hidden></ol>
  <a class="text-link" href={github.discussions}>See every discussion <Icon/></a>
</section>

<script>
import { mountDiscussions } from '../lib/discussion-feed';
mountDiscussions();
</script>

<style>
.discussion-feed{margin-top:64px;border-top:1px solid var(--line);padding-top:48px}
.discussion-feed h2{font-size:40px;margin-top:24px}
.discussion-note{margin-top:16px;max-width:560px;font-size:16px;line-height:1.6;color:#555}
.discussion-note a{color:#111;text-decoration:underline;text-underline-offset:4px;text-decoration-thickness:1px}
.discussion-list{list-style:none;margin:32px 0 8px;padding:0;border-bottom:1px solid var(--line)}
.discussion-list :global(li){border-top:1px solid var(--line);padding:20px 0}
.discussion-list :global(.discussion-title){display:block;font-size:20px;font-weight:500;letter-spacing:-.02em;line-height:1.35}
.discussion-list :global(.discussion-title:is(:hover,:focus-visible)){color:#245794}
.discussion-list :global(.discussion-meta){display:block;margin-top:8px;font-family:var(--mono);font-size:11px;letter-spacing:.04em;color:#6a6a6a}
.discussion-feed>.text-link{margin-top:16px}
@media(max-width:768px){.discussion-feed{margin-top:48px;padding-top:40px}.discussion-feed h2{font-size:32px}.discussion-list :global(.discussion-title){font-size:18px}}
</style>
