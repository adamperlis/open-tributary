---
import Icon from './Icon.astro';
---
<form class="join-form" data-preview-form="join" aria-describedby="join-note">
<fieldset><legend>I’m here as a</legend><div class="role-picker">{[{label:'Creator',value:'maintainer'}, {label:'Builder',value:'builder'}, {label:'Both',value:'both'}].map((role, i) => <label><input type="radio" name="role" value={role.value} checked={i === 0} required /><span>{role.label}</span></label>)}</div></fieldset>
<label class="field">Email address<input type="email" name="email" required autocomplete="email" placeholder="you@example.com" maxlength="254" /></label>
<label class="field">Project or GitHub URL <span class="optional">Optional</span><input type="url" name="project" placeholder="https://github.com/you/project" maxlength="500" /></label>
<label class="field">Anything you want us to know? <span class="optional">Optional</span><textarea name="note" rows="3" maxlength="2000" placeholder="Your project, your questions, your perspective." /></label>
<button type="submit" disabled class="button form-submit">Join the waitlist <Icon /></button>
<p class="form-note" id="join-note">Preview mode. This form demonstrates signup; nothing is sent or stored.</p><noscript><p class="form-note">Enable JavaScript to try the form preview. Submissions are not connected.</p></noscript>
</form>
<script>
document.querySelectorAll<HTMLButtonElement>('[data-preview-form="join"] button[type="submit"]').forEach(button => button.disabled = false);
const form = document.querySelector<HTMLFormElement>('[data-preview-form="join"]');
const role = new URLSearchParams(location.search).get('role');
if (role && ['maintainer', 'builder', 'both'].includes(role)) { const input = form?.querySelector<HTMLInputElement>(`input[value="${role}"]`); if (input) input.checked = true; }
form?.addEventListener('submit', event => { event.preventDefault(); if (form.reportValidity()) location.assign('/join/thanks?preview=1'); });
</script>
