---
import { gatewayRiverPath } from '../lib/river-shape';
import { FLOW_INK, flowColor } from '../lib/flow-palette';
---
<div class="gateway-host footer-constellation" data-footer-constellation data-orientation="horizontal" data-available="false" aria-hidden="true">
 <div class="gateway-still"><svg viewBox="0 0 1000 1000" preserveAspectRatio="none">
  <g transform="translate(550 540) rotate(-90) scale(1 1.65) translate(-500 -790)" fill="none" stroke={flowColor(FLOW_INK.filament)} stroke-width=".7" stroke-dasharray="1 4" opacity=".25">
   {Array.from({length:80},(_,i)=><path d={gatewayRiverPath(i,{spread:.26,source:.42,junction:.79})} vector-effect="non-scaling-stroke"/>)}
  </g>
 </svg></div>
 <canvas class="tributary-canvas"></canvas>
</div>
<script>
import type { TributaryField } from '../lib/tributary-field';
for(const host of document.querySelectorAll<HTMLElement>('[data-footer-constellation]')){
 const canvas=host.querySelector<HTMLCanvasElement>('canvas')!;
 const reduced=matchMedia('(prefers-reduced-motion:reduce)');
 let field:TributaryField|null=null,inView=false,loading=false,disposed=false;
 const update=()=>{
  host.dataset.reduced=String(reduced.matches);
  host.dataset.available=String(Boolean(field)&&!reduced.matches&&!host.dataset.fieldError);
  field?.setRunning(inView&&!document.hidden&&!reduced.matches);
 };
 const load=async()=>{
  if(field||loading||disposed||reduced.matches)return;
  loading=true;
  try{
   const { mountTributaryField }=await import('../lib/tributary-field');
   if(!disposed){field=mountTributaryField(canvas,host,{orientation:'horizontal'});update();}
  }catch{host.dataset.fieldError='Renderer unavailable';update();}
  finally{loading=false;}
 };
 const preference=()=>{update();if(inView)void load();};
 const observer=new IntersectionObserver(([entry])=>{
  inView=entry.isIntersecting;update();if(inView)void load();
 });
 observer.observe(host.closest('.site-footer')??host);
 document.addEventListener('visibilitychange',update);
 reduced.addEventListener('change',preference);
 canvas.addEventListener('webglcontextlost',update);
 const hide=(event:PageTransitionEvent)=>{
  field?.setRunning(false);
  if(!event.persisted){disposed=true;observer.disconnect();field?.dispose();document.removeEventListener('visibilitychange',update);reduced.removeEventListener('change',preference);canvas.removeEventListener('webglcontextlost',update);window.removeEventListener('pagehide',hide);window.removeEventListener('pageshow',show);}
 };
 const show=(event:PageTransitionEvent)=>{if(event.persisted)update();};
 window.addEventListener('pagehide',hide);window.addEventListener('pageshow',show);
 update();
}
</script>
