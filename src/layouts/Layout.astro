---
import '@fontsource-variable/dm-sans/wght.css';
import '@fontsource/dm-mono/latin-400.css';
import '../styles/global.css';
import '../styles/gateway.css';
import '../styles/centered-river.css';
import 'lenis/dist/lenis.css';
import Icon from '../components/Icon.astro';
import FooterConstellation from '../components/FooterConstellation.astro';
import Wordmark from '../components/Wordmark.astro';
import Analytics from '@vercel/analytics/astro';
import { pageDates, proposalVersion } from '../lib/pages';
import { github } from '../lib/links';
interface Props { title?: string; description?: string; }
const { title = 'Open Tributary — Value should flow back.', description = 'A whitepaper proposal for royalties in shared software. We’re seeking feedback from the community.' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site!);
const socialImage = new URL('/og.png', Astro.site!);
const indexable = import.meta.env.PUBLIC_SITE_INDEXABLE === 'true' && !path.startsWith('/join') && path !== '/brand-study';
const site = Astro.site!, dates = pageDates[path];
const id = (name: string) => new URL(`/#${name}`, site).href;
const publisherId = id('publisher'), siteId = id('website'), projectId = id('project'), authorId = id('adam-perlis');
const pageId = `${canonical.href}#webpage`, breadcrumbId = `${canonical.href}#breadcrumb`;
const contentLicense = 'https://creativecommons.org/licenses/by/4.0/';
const image = { '@type': 'ImageObject', url: socialImage.href, width: 1200, height: 630 };
const crumbs: Record<string, string> = { '/license': 'The proposal', '/manifesto': 'Manifesto' };
// The publisher, the project and its author are declared on every page so each resolves to one entity everywhere.
const graph: Record<string, unknown>[] = [
  { '@type': 'Organization', '@id': publisherId, name: 'B150', url: 'https://b150.ai' },
  { '@type': 'Project', '@id': projectId, name: 'Open Tributary', url: site.href, description: 'A proposed payment protocol that would route royalties to open source creators when products built on their code earn revenue, paired with the Open Royalty License (ORL).', sameAs: [github.repo], founder: { '@id': authorId }, parentOrganization: { '@id': publisherId } },
  { '@type': 'Person', '@id': authorId, name: 'Adam Perlis', sameAs: ['https://github.com/adamperlis'] },
  { '@type': 'WebPage', '@id': pageId, url: canonical.href, name: title, description, inLanguage: 'en', isPartOf: { '@id': siteId }, about: { '@id': projectId }, publisher: { '@id': publisherId }, primaryImageOfPage: image, ...(dates && { datePublished: dates.published, dateModified: dates.modified }), ...(crumbs[path] && { breadcrumb: { '@id': breadcrumbId } }) }
];
if (path === '/') graph.push({ '@type': 'WebSite', '@id': siteId, name: 'Open Tributary', url: site.href, description, inLanguage: 'en', about: { '@id': projectId }, publisher: { '@id': publisherId } });
if (crumbs[path]) graph.push({ '@type': 'BreadcrumbList', '@id': breadcrumbId, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: site.href }, { '@type': 'ListItem', position: 2, name: crumbs[path], item: canonical.href }] });
if (path === '/manifesto' && dates) graph.push({ '@type': ['BlogPosting', 'NewsArticle'], '@id': `${canonical.href}#article`, headline: 'The era of personal software', description, author: { '@id': authorId }, publisher: { '@id': publisherId }, isPartOf: { '@id': siteId }, mainEntityOfPage: { '@id': pageId }, about: { '@id': projectId }, datePublished: dates.published, dateModified: dates.modified, image, articleSection: 'Manifesto', keywords: ['personal software', 'open source', 'open source funding', 'royalties', 'Open Royalty License', 'Open Tributary'], license: contentLicense, inLanguage: 'en', speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.manifesto-content .prose > p:first-of-type'] } });
if (path === '/license' && dates) graph.push({ '@type': 'CreativeWork', '@id': `${canonical.href}#proposal`, name: 'Open Royalty License (ORL): draft principles', alternateName: 'ORL', description, url: canonical.href, version: proposalVersion, creativeWorkStatus: 'Draft', author: { '@id': authorId }, publisher: { '@id': publisherId }, isPartOf: { '@id': siteId }, mainEntityOfPage: { '@id': pageId }, about: { '@id': projectId }, datePublished: dates.published, dateModified: dates.modified, license: contentLicense, image, inLanguage: 'en', speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.reading-body > .lead'] } });
const structuredData = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="robots" content={indexable ? 'index, follow' : 'noindex, follow'} /><meta name="theme-color" content="#000000" /><title>{title}</title><link rel="icon" href="/favicon.ico?v=flow-6" sizes="16x16 32x32 48x48" /><link rel="icon" type="image/png" href="/favicon-32.png?v=flow-6" sizes="32x32" /><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=flow-6" sizes="any" /><link rel="apple-touch-icon" href="/apple-touch-icon.png?v=flow-6" sizes="180x180" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><link rel="canonical" href={canonical.href} /><meta property="og:url" content={canonical.href} /><meta property="og:site_name" content="Open Tributary" /><meta property="og:type" content={path === '/manifesto' ? 'article' : 'website'} />{path === '/manifesto' && dates && <><meta property="article:published_time" content={dates.published} /><meta property="article:modified_time" content={dates.modified} /><meta property="article:author" content="Adam Perlis" /></>}<meta property="og:image" content={socialImage.href} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Open Tributary: Your code. Their products. You should get paid. A whitepaper proposal." /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={socialImage.href} /><script type="application/ld+json" set:html={structuredData} />

<Analytics /></head><body data-page={path === '/' ? 'home' : path.split('/')[1]}>
<a class="skip-link" href="#main">Skip to content</a>
<div class="site-chrome"><div class="announcement"><span>OPEN TRIBUTARY IS A WHITEPAPER PROPOSAL</span><a href="/license#feedback">Help shape it <Icon size={12}/></a></div><header class="site-header wrap"><Wordmark/><nav aria-label="Main navigation"><a class:list={['nav-link',{current:path === '/manifesto'}]} href="/manifesto">Manifesto</a><a class:list={['nav-link',{current:path === '/license'}]} href="/license">The proposal</a><a href="/join" class="button button-small">Join the conversation <Icon size={16}/></a></nav></header></div>
<main id="main"><slot /></main>
<footer class="site-footer" data-reveal-group={path === '/' ? 'footer' : undefined}><FooterConstellation/><div class="wrap"><div class="footer-top" data-reveal={path === '/' ? 'detail' : undefined}><Wordmark/><div class="footer-links"><a href="/manifesto">Manifesto</a><a href="/license">The proposal</a><a href="https://github.com/adamperlis/open-tributary">GitHub <Icon size={16}/></a></div></div><p class="footer-statement" data-reveal={path === '/' ? 'lead' : undefined}>Value should<br />flow back.</p><div class="footer-bottom"><p>A <a href="https://b150.ai">B150</a> project. Built in the open.</p><span>A PROPOSAL. AN OPEN CONVERSATION.</span></div></div></footer>
<script>
import Lenis from 'lenis';
import { mountPageReveals } from '../lib/page-reveals';
import { mountAmbientFlows } from '../lib/ambient-flows';
mountPageReveals();
mountAmbientFlows();
const desktop = window.matchMedia('(pointer: fine) and (min-width: 769px)');
const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
let scroller: Lenis | undefined;
function configureScroll() {
  scroller?.destroy();
  scroller = undefined;
  if (!desktop.matches || reduced.matches) return;
  const chrome = document.querySelector<HTMLElement>('.site-chrome');
  scroller = new Lenis({
    autoRaf: true,
    duration: .26,
    easing: (t: number) => 1 - Math.pow(1 - t, 3),
    syncTouch: false,
    respectReducedMotion: true,
    anchors: { offset: -(chrome?.offsetHeight ?? 120) - 24, duration: .26 }
  });
}
configureScroll();
desktop.addEventListener('change', configureScroll);
reduced.addEventListener('change', configureScroll);
window.addEventListener('pagehide', () => { scroller?.destroy(); scroller = undefined; });
window.addEventListener('pageshow', (event) => { if (event.persisted) configureScroll(); });
</script>
</body></html>
