---
import '@fontsource-variable/dm-sans/wght.css';
import '@fontsource/dm-mono/latin-400.css';
import '../styles/global.css';
import '../styles/gateway.css';
import 'lenis/dist/lenis.css';
import Mark from '../components/Mark.astro';
import Icon from '../components/Icon.astro';
interface Props { title?: string; description?: string; }
const { title = 'Tributary — Value should flow back.', description = 'A whitepaper proposal for royalties in shared software. We’re seeking feedback from the community.' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site!);
const socialImage = new URL('/og.png', Astro.site!);
const publisherId = new URL('/#publisher', Astro.site!).href;
const siteId = new URL('/#website', Astro.site!).href;
const indexable = import.meta.env.PUBLIC_SITE_INDEXABLE === 'true' && !path.startsWith('/join') && path !== '/brand-study';
const graph: Record<string, unknown>[] = [
  { '@type': 'Organization', '@id': publisherId, name: 'B150', url: 'https://b150.ai' },
  { '@type': 'WebPage', '@id': `${canonical.href}#webpage`, url: canonical.href, name: title, description, inLanguage: 'en', isPartOf: { '@id': siteId }, publisher: { '@id': publisherId } }
];
if (path === '/') graph.push({ '@type': 'WebSite', '@id': siteId, name: 'Tributary', url: Astro.site!.href, description, publisher: { '@id': publisherId } });
if (path === '/manifesto') graph.push({ '@type': 'Article', '@id': `${canonical.href}#article`, headline: 'The era of personal software', description, author: { '@type': 'Person', name: 'Adam Perlis' }, publisher: { '@id': publisherId }, mainEntityOfPage: { '@id': `${canonical.href}#webpage` }, image: socialImage.href, inLanguage: 'en' });
if (path === '/license') graph.push({ '@type': 'CreativeWork', '@id': `${canonical.href}#proposal`, name: 'Open Royalty License — draft principles', description, url: canonical.href, creativeWorkStatus: 'Draft', publisher: { '@id': publisherId }, inLanguage: 'en' });
const structuredData = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="robots" content={indexable ? 'index, follow' : 'noindex, follow'} /><meta name="theme-color" content="#000000" /><title>{title}</title><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><link rel="canonical" href={canonical.href} /><meta property="og:url" content={canonical.href} /><meta property="og:site_name" content="Tributary" /><meta property="og:type" content={path === '/manifesto' ? 'article' : 'website'} /><meta property="og:image" content={socialImage.href} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Tributary: Your code. Their products. You should get paid. A whitepaper proposal." /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={socialImage.href} /><script type="application/ld+json" set:html={structuredData} />

</head><body data-page={path === '/' ? 'home' : path.split('/')[1]}>
<a class="skip-link" href="#main">Skip to content</a>
<div class="site-chrome"><div class="announcement"><span>TRIBUTARY IS A WHITEPAPER PROPOSAL</span><a href="/license#feedback">Help shape it <Icon size={12}/></a></div><header class="site-header wrap"><a href="/" class="brand" aria-label="Tributary home"><Mark />tributary</a><nav aria-label="Main navigation"><a class:list={['nav-link',{current:path === '/manifesto'}]} href="/manifesto">Manifesto</a><a class:list={['nav-link',{current:path === '/license'}]} href="/license">The proposal</a><a href="/join" class="button button-small">Join the conversation <Icon size={16}/></a></nav></header></div>
<main id="main"><slot /></main>
<footer class="site-footer"><div class="wrap"><div class="footer-top"><a href="/" class="brand" aria-label="Tributary home"><Mark />tributary</a><div class="footer-links"><a href="/manifesto">Manifesto</a><a href="/license">The proposal</a><a href="https://github.com/adamperlis/open-tributary">GitHub <Icon size={16}/></a></div></div><p class="footer-statement">Value should<br />flow back.</p><div class="footer-bottom"><p>A <a href="https://b150.ai">B150</a> project. Built in the open.</p><span>A PROPOSAL. AN OPEN CONVERSATION.</span></div></div></footer>
<script>
import Lenis from 'lenis';
const desktop = window.matchMedia('(pointer: fine) and (min-width: 769px)');
const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
let scroller: Lenis | undefined;
function configureScroll() {
  scroller?.destroy();
  scroller = undefined;
  if (!desktop.matches || reduced.matches) return;
  const chrome = document.querySelector<HTMLElement>('.site-chrome');
  scroller = new Lenis({
    autoRaf: true,
    duration: .26,
    easing: (t: number) => 1 - Math.pow(1 - t, 3),
    syncTouch: false,
    respectReducedMotion: true,
    anchors: { offset: -(chrome?.offsetHeight ?? 120) - 24, duration: .26 }
  });
}
configureScroll();
desktop.addEventListener('change', configureScroll);
reduced.addEventListener('change', configureScroll);
window.addEventListener('pagehide', () => { scroller?.destroy(); scroller = undefined; });
window.addEventListener('pageshow', (event) => { if (event.persisted) configureScroll(); });
</script>
</body></html>
