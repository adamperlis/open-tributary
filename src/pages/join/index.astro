---
import Layout from '../../layouts/Layout.astro';
import Feedback from '../../components/Feedback.astro';
import FlowBands from '../../components/FlowBands.astro';
import Icon from '../../components/Icon.astro';
import { github } from '../../lib/links';
---
<Layout title="Join the conversation — Open Tributary" description="Join the public conversation about the Open Tributary proposal on GitHub: pick an open question, add your perspective, or start a new discussion."><section class="join-page"><div class="join-story"><FlowBands id="signup-flow" composition="cascade" tone="green"/><div class="join-story-copy"><span class="eyebrow">HELP SHAPE WHAT’S NEXT</span><h1>Your work.<br />A fair share.<br />A better future.</h1><p>Publish code others build on? Help define royalties that could support your project. Builders are welcome to challenge the model too.</p><div class="join-story-links"><a class="text-link" href="/license">Read the proposal <Icon/></a><a class="text-link" href={github.discussions}>Discuss it on GitHub <Icon/></a></div><span class="join-story-note">CREATORS FIRST. COMMUNITY SHAPED.</span></div></div><div class="join-form-panel"><Feedback variant="panel" eyebrow="JOIN THE CONVERSATION" heading="Let’s make it work." intro="The proposed terms are still open. Pick a question below, add your perspective, or start a new thread. It all happens in public on GitHub." /></div></section></Layout>
