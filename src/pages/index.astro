---
import Layout from '../layouts/Layout.astro';
import FlowBands from '../components/FlowBands.astro';
import GatewayScene from '../components/GatewayScene';
import River from '../components/River.astro';
import Icon from '../components/Icon.astro';
const questions=[['clean-room','What if someone rebuilds your code from scratch?'],['ai-rewrites','Should an AI rewrite still credit the original?'],['relative-value','Does a button earn as much as an entire system?'],['attribution','How do we know whose work created the value?'],['payment-limits','How would royalties actually get collected?']];
---
<Layout title="Tributary — Royalties for the people who create the code" description="A community whitepaper proposing royalties for software creators when products built on their work earn revenue. Read the proposal and challenge its assumptions.">
<div class="river-story"><span id="flow" class="story-anchor" aria-hidden="true"></span><div class="river-stage"><div class="story-field"><GatewayScene client:load /></div>
<section class="home-hero"><div class="wrap hero-inner"><h1>Your code.<br />Their products.<br />You should get paid.</h1><p class="hero-description">You publish the code that makes other products possible. Tributary proposes royalties that return to you when those products earn.</p><div class="hero-actions"><a class="button" href="/join?role=maintainer">Join as a creator <Icon/></a><a class="button button-outline" href="/license">Explore the proposal <Icon/></a></div><p class="hero-note"><span class="status-dot"></span>Community feedback welcome. The terms are still taking shape.</p><a class="river-scroll-cue" href="#flow"><span>Follow the current</span><Icon name="arrow-down-linear" size={16}/></a></div></section>
<section class="mechanism-section"><div class="wrap mechanism-grid"><div class="mechanism-copy"><h2>Code goes out.<br />Value comes back.</h2></div><River connected/></div></section>
<section class="thesis-section river-thesis" id="why"><FlowBands id="why-flow" class="thesis-current"/><div class="wrap thesis-inner"><span class="eyebrow">02 / WHERE VALUE RETURNS</span><div class="thesis-grid"><h2>Back to the people <br />who make it possible.</h2><div class="thesis-description"><p>When products built on your work earn, a share would flow back to you—and the maintainers behind the foundations.</p><a class="text-link" href="/license">Read the draft principles <Icon/></a></div></div></div><div class="current-destination" aria-hidden="true"><span>CREATORS &amp; MAINTAINERS</span><i></i></div></section>
</div></div>
<div class="proposal-details"><div class="wrap"><div class="proposal-facts" data-reveal-group="facts"><div data-reveal="body"><span class="eyebrow">THE STANDARD</span><strong>Open Royalty License</strong><p>The proposed terms for commercial reuse.</p></div><div data-reveal="body"><span class="eyebrow">THE PROTOCOL</span><strong>Tributary</strong><p>The proposed route back to creators.</p></div><div data-reveal="body"><span class="eyebrow">THE STATUS</span><strong>Open for discussion</strong><p>Rates, allocation, and enforcement are unresolved.</p></div></div></div></div>
<section class="participation-section wrap" id="community"><div class="section-intro" data-reveal="lead"><span class="eyebrow">03 / TWO SIDES OF THE SAME CURRENT</span><h2>Built by creators.<br />Made workable together.</h2></div><div class="participation-grid" id="contributors"><FlowBands id="people-flow" tone="green" class="people-flow" reveal="flow"/><article class="creator-panel" data-reveal-group="creator"><span class="label-tag" data-reveal="detail">FOR CREATORS &amp; MAINTAINERS</span><h3 data-reveal="lead">A stake in what<br />your work makes<br />possible.</h3><p data-reveal="body">Help define royalties that could support the projects you publish and the work of keeping them useful.</p><a data-reveal="detail" class="text-link" href="/join?role=maintainer">Join as a creator <Icon/></a></article><article class="builder-panel" data-reveal-group="builder"><span class="label-tag" data-reveal="detail">FOR BUILDERS</span><h3 data-reveal="lead">A model you can<br />actually build with.</h3><p data-reveal="body">Clear terms. Understandable costs. A reason to support the original instead of avoiding it. Help us make adoption practical.</p><a data-reveal="detail" class="text-link" href="/join?role=builder">Join as a builder <Icon/></a></article></div></section>
<section class="challenge-section" id="questions"><div class="wrap" data-reveal-group="questions"><span class="eyebrow" data-reveal="detail">04 / THE PART WE NEED TO GET RIGHT</span><h2 data-reveal="lead">A fair idea has to<br />survive hard questions.</h2><div class="challenge-grid"><p data-reveal="body">This is a whitepaper proposal. We’re sharing the assumptions, the flaws, and the places it could break. Challenge them with us.</p><div class="question-list" data-reveal-group="question-list">{questions.map(([id,text],i)=><a data-reveal="detail" href={`/license#${id}`}><span class="question-index">0{i+1}</span><span>{text}</span><Icon/></a>)}</div></div><a data-reveal="detail" class="text-link" href="/license#limitations">Read all the flaws and limitations <Icon/></a></div></section>
<section class="join-call"><div class="join-call-art" aria-hidden="true"><FlowBands id="join-call-flow" tone="warm" reveal="flow"/></div><div class="wrap" data-reveal-group="join"><span class="eyebrow" data-reveal="detail">LET’S BUILD THIS TOGETHER</span><h2 data-reveal="lead">A better deal<br />starts with you.</h2><p data-reveal="body">Publish code others build on? Help shape what royalties could mean for your project.</p><div class="hero-actions" data-reveal="detail"><a class="button" href="/join?role=maintainer">Join as a creator <Icon/></a><a class="button button-outline" href="/license#feedback">Challenge the proposal <Icon/></a></div></div></section>
</Layout>
