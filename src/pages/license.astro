---
import Layout from '../layouts/Layout.astro';
import Feedback from '../components/Feedback.astro';
import FlowBands from '../components/FlowBands.astro';
import RoyaltyLoop from '../components/RoyaltyLoop.astro';
import DiscussionFeed from '../components/DiscussionFeed.astro';
import ProposalLimitations from '../components/ProposalLimitations.astro';
import { pageDates, proposalVersion, formatDate } from '../lib/pages';
const principles=[['Personal use stays free.','Personal use and remixing would not trigger royalties. The model is intended to keep experimentation accessible.'],['Earnings trigger an obligation.','Revenue-generating uses would contribute under terms still being defined. Building something and earning from it are different moments.'],['Contributions relate to revenue.','The royalty basis, thresholds, and rates remain open design questions. The goal is to align the contribution with real earnings.'],['Distribution should be automatic.','Open Tributary would aim to track dependencies and route royalties to their creators. The mechanism is not yet implemented.'],['Attribution follows the code.','Creator credit should distinguish reuse, adaptation, and known references. A credit record would not, by itself, establish a royalty obligation.']];
---
<Layout title="Open Royalty License (ORL) proposal — Open Tributary" description="The Open Royalty License (ORL) draft: free to build on, royalties only when products earn. Read the principles, open questions, and limits, then give feedback."><section class="document-masthead license-masthead"><FlowBands id="license-flow" composition="fan" tone="warm"/><div class="document-header wrap"><a href="/" class="eyebrow back-link">OPEN TRIBUTARY / THE STANDARD</a><div class="document-status"><span class="status-dot"></span><span>Whitepaper proposal · Draft v{proposalVersion} · Updated <time datetime={pageDates['/license'].modified}>{formatDate(pageDates['/license'].modified)}</time> · Community feedback welcome</span></div><h1>Open Royalty<br />License<span class="blue-text">.</span></h1><p class="document-intro">A proposed agreement for shared software.<br />Free to build on. A contribution when you earn.</p></div></section><div class="reading-page wrap"><div class="document-grid"><aside class="document-nav" aria-label="On this page"><span class="eyebrow">IN THIS DRAFT</span><a href="#how-it-works">How it would work</a><a href="#principles">The principles</a><a href="#questions">Open questions</a><a href="#limitations">Where this could break</a><a href="#discussion">Public discussion</a><a href="#feedback">Give feedback</a><div class="draft-aside">A living proposal.<br />Help us get it right.</div></aside><div class="reading-body"><div class="draft-notice">This is a statement of principles, not final license terms. Legal text is in progress.</div><p class="lead">The ORL is part of a whitepaper proposal for royalties when products built on licensed code earn revenue. We’re sharing these draft principles to seek feedback from the community; the terms are still being developed.</p><section id="how-it-works" class="royalty-loop"><span class="eyebrow">HOW IT WOULD WORK</span><h2>Open source stays free until it earns. Then every creator gets paid.</h2><RoyaltyLoop/></section><section id="principles" class="principles">{principles.map(([title, body], i) => <article><span class="principle-number">0{i+1}</span><div><h2>{title}</h2><p>{body}</p></div></article>)}</section><section id="questions" class="document-questions"><span class="eyebrow">WHAT WE STILL NEED TO SOLVE</span><h2>The hard questions are part of the work.</h2><p>How do we define revenue? How should contributions from indirect dependencies be attributed? How do we weigh a reusable button against an entire system? What would compatibility with existing licenses require? When should an AI rewrite preserve credit, and when would it owe compensation? How can attribution be audited?</p><p>We’re inviting maintainers, builders, and people with relevant experience to challenge the model before these principles become terms.</p></section><ProposalLimitations /><DiscussionFeed /><Feedback heading="Which assumption should we challenge?" /></div></div></div></Layout>
